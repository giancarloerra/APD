{
  "name": "apd-astrophotography-dashboard",
  "version": "1.3.0",
  "description": "Astrophotography Planning Dashboard — unified weather forecasts, interactive sky chart, and AI-friendly forecast summaries for astrophotographers.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/giancarloerra/apd.git"
  },
  "homepage": "https://github.com/giancarloerra/apd#readme",
  "bugs": {
    "url": "https://github.com/giancarloerra/apd/issues"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "client:dev": "vite",
    "server:dev": "nodemon --watch server --ignore server/data --exec node server/index.js",
    "build": "vite build",
    "build:server": "echo 'Server build complete'",
    "start": "node server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "release-it"
  },
  "dependencies": {
    "@upstash/redis": "^1.36.3",
    "aladin-lite": "3.6.5",
    "astronomy-engine": "2.1.19",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.9.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.35",
    "release-it": "^21.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.1"
    },
    "get-uri@^8": {
      "basic-ftp": "^6.2.1"
    }
  }
}
